    "a11y:test": "node scripts/accessibility-contract-test.mjs",
    "unit:test": "node --test tests/*.test.mjs",
    "test": "npm run unit:test && npm run security:test && npm run contract:test && npm run hygiene:test && npm run design:test && npm run a11y:test && npm run workspace:test && npm run upstream:310-test",
    "e2e:smoke": "bash scripts/e2e-preview-smoke.sh",
    "audit:test": "npm run test && npm run build && npm run e2e:smoke",
